"""Compiling JavaScript to QuickJS bytecode at build time."""

load("@rules_cc//cc:defs.bzl", "cc_library")

_ALNUM = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

def _c_name(text):
    # What qjsc does to a file's name (with `-p`): every character that is not an ASCII letter or
    # digit becomes an underscore.
    return "".join([c if c in _ALNUM else "_" for c in text.elems()])

def _stem(path):
    # The file's name without the directories, and without what follows its last dot.
    base = path.rsplit("/", 1)[-1]
    dot = base.rfind(".")
    return base if dot < 0 else base[:dot]

def _js_bytecode_src_impl(ctx):
    prefix = _c_name(ctx.attr.cname) + "_"
    names = []
    for src in ctx.files.srcs:
        name = prefix + _c_name(_stem(src.path))
        if name in names:
            fail("{}: {} has the same C name, {}, as an earlier source".format(
                ctx.label,
                src.short_path,
                name,
            ))
        names.append(name)

    source = ctx.actions.declare_file(ctx.attr.cname + ".c")
    header = ctx.actions.declare_file(ctx.attr.cname + ".h")

    ctx.actions.run(
        executable = ctx.executable._qjsc,
        arguments = [
            # Plain scripts that set globals, whatever they look like: qjsc would otherwise make
            # a module of one with an `import` or `export` in it.
            "-C",
            "-p",
            prefix,
            "-o",
            source.path,
        ] + [src.path for src in ctx.files.srcs],
        inputs = ctx.files.srcs,
        outputs = [source],
        mnemonic = "Qjsc",
        progress_message = "Compiling %{label} to bytecode",
        use_default_shell_env = False,
    )

    declarations = []
    for name in names:
        declarations.append("extern uint8_t const {name}[];".format(name = name))
        declarations.append("extern uint32_t const {name}_size;".format(name = name))
    scripts = "".join([
        "\n\t\t{{static_cast<uint8_t const*>({name}), {name}_size}},".format(name = name)
        for name in names
    ])
    ctx.actions.write(
        output = header,
        content = """\
// Generated by js_bytecode for {label}.
// One bytecode array and its length for each source, in the order of `srcs`: the script compiled
// by QuickJS, for JS_ReadObject and then JS_EvalFunction.
#pragma once

#include <stdint.h>

#ifdef __cplusplus
#include <array>
#include <span>

extern "C" {{
#endif

{declarations}

#ifdef __cplusplus
}}

// Every script, in the order of `srcs`.
inline auto {cname}() noexcept -> std::array<std::span<uint8_t const>, {count}>
{{
	return {{{{{scripts}
	}}}};
}}
#endif
""".format(
            label = "//{}:{}".format(ctx.label.package, ctx.attr.cname),
            declarations = "\n".join(declarations),
            cname = prefix[:-1],
            count = len(names),
            scripts = scripts,
        ),
    )
    return [DefaultInfo(files = depset([source, header]))]

_js_bytecode_src = rule(
    implementation = _js_bytecode_src_impl,
    doc = """Compiles `srcs` with `qjsc`, in one action, to `<cname>.c` and declares it in `<cname>.h`.""",
    attrs = {
        "cname": attr.string(
            mandatory = True,
            doc = "The name of the two outputs, and the start of every C name in them.",
        ),
        "srcs": attr.label_list(
            mandatory = True,
            allow_empty = False,
            allow_files = [".js"],
            doc = "The scripts.",
        ),
        "_qjsc": attr.label(
            default = "//deps/thirdparty:qjsc",
            executable = True,
            cfg = "exec",
        ),
    },
)

def js_bytecode(name, srcs, visibility = None, testonly = False):
    """A `cc_library` of JavaScript scripts compiled to QuickJS bytecode.

    `qjsc` compiles `srcs` in one run, as plain scripts (not modules) that set globals, keeping
    their debug information, so an error thrown from one has a readable stack trace. The library has
    one header, `<name>.h`, with an array and its size for each source. They are named
    `<name>_<stem>` and `<name>_<stem>_size`, where `<stem>` is the file's name without its last
    extension and with every character other than an ASCII letter or digit as `_`, and are in the
    order of `srcs`, so the first script can be a library and the next one its shim:

        extern uint8_t const name_stem[];
        extern uint32_t const name_stem_size;

    In C++, `name()` returns them all, in order, as a `std::array` of `std::span<uint8_t const>`.
    Evaluating them in that order, each with `JS_ReadObject` and `JS_EvalFunction`, runs the
    scripts. `name` has to be unique in a binary, and so does each stem in `srcs`.

    The bytecode is built in the exec configuration and loaded by the target one. That only works
    because they are the same platform and the same QuickJS here (nothing is cross-compiled):
    `JS_ReadObject` rejects bytecode of another QuickJS version.

    Args:
      name: The name of the library, and of its header, `<name>.h`.
      srcs: The `.js` files, in the order to evaluate them.
      visibility: The visibility of the library.
      testonly: Whether only tests can depend on it.
    """
    _js_bytecode_src(
        name = name + "_src",
        cname = name,
        srcs = srcs,
        testonly = testonly,
        visibility = ["//visibility:private"],
    )
    cc_library(
        name = name,
        srcs = [":" + name + "_src"],
        hdrs = [":" + name + "_src"],
        includes = ["."],
        # Generated code, which clang-tidy has no business in.
        tags = ["no-lint"],
        testonly = testonly,
        visibility = visibility,
    )
