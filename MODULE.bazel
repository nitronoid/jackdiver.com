    sha256 = "4453e66a326f350821622912d99115eefe6a636838a10a279e341254ef00594d",
    strip_prefix = "dart-sass",
    url = "https://github.com/sass/dart-sass/releases/download/1.105.1/dart-sass-1.105.1-macos-arm64.tar.gz",
)

http_archive(
