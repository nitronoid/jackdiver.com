load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load(":defs.bzl", "sass_css")

package(default_visibility = ["//:__subpackages__"])

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "linux_x64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

_UNSUPPORTED = "dart-sass is fetched for macOS arm64 and Linux x64 only; see MODULE.bazel"

alias(
    name = "dart",
    actual = select(
        {
            ":linux_x64": "@dart_sass_linux_x64//:dart",
            ":macos_arm64": "@dart_sass_macos_arm64//:dart",
        },
        no_match_error = _UNSUPPORTED,
    ),
)

alias(
    name = "snapshot",
    actual = select(
        {
            ":linux_x64": "@dart_sass_linux_x64//:snapshot",
            ":macos_arm64": "@dart_sass_macos_arm64//:snapshot",
        },
        no_match_error = _UNSUPPORTED,
    ),
)

sass_css(
    name = "fixture",
    src = "testdata/main.scss",
    srcs = [
        "testdata/_base.scss",
        "testdata/_part.scss",
    ],
)

diff_test(
    name = "sass_test",
    file1 = "testdata/expected.css",
    file2 = ":fixture",
)
